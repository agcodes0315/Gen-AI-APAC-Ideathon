rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read, write:
        if request.auth != null &&
           request.auth.uid == userId;

      match /journals/{journalId} {
        allow read, write:
          if request.auth != null &&
             request.auth.uid == userId;
      }

      match /conversations/{conversationId} {
        allow read, write:
          if request.auth != null &&
             request.auth.uid == userId;

        match /messages/{messageId} {
          allow read, write:
            if request.auth != null &&
               request.auth.uid == userId;
        }
      }

      match /thoughtSnapshots/{snapshotId} {
        allow read, write:
          if request.auth != null &&
             request.auth.uid == userId;
      }

      match /thoughtDiffs/{diffId} {
        allow read, write:
          if request.auth != null &&
             request.auth.uid == userId;
      }

      match /provenance/{provenanceId} {
        allow read, write:
          if request.auth != null &&
             request.auth.uid == userId;
      }

      /*
       * Perspective Watch remains owner-bound exactly like the
       * journal, approved memory, Thought Diffs and provenance.
       */
      match /perspectiveWatches/{watchId} {
        allow read, write:
          if request.auth != null &&
             request.auth.uid == userId;
      }
    }

    /*
     * IMPORTANT:
     *
     * perspectiveWatchQueue/* and mail/* are intentionally NOT
     * exposed to browser clients. They are written only through
     * the Firebase Admin SDK running on the trusted backend.
     *
     * Admin SDK access is controlled by IAM and bypasses client
     * Firestore Security Rules.
     */
    match /perspectiveWatchQueue/{queueId} {
      allow read, write: if false;
    }

    match /mail/{mailId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
