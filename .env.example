NODE_ENV=development
PORT=3000

FIREBASE_PROJECT_ID=your-firebase-project-id
GEMINI_API_KEY=replace-with-server-secret

VITE_FIREBASE_API_KEY=your-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-firebase-app-id
VITE_FIREBASE_VAPID_KEY=your-public-vapid-key

MIRRORTRACE_APP_URL=http://localhost:3000

MIRRORTRACE_SMTP_HOST=smtp.gmail.com
MIRRORTRACE_SMTP_PORT=465
MIRRORTRACE_SMTP_SECURE=true
MIRRORTRACE_SMTP_USER=your-sender@example.com
MIRRORTRACE_SMTP_PASSWORD=replace-with-secret
MIRRORTRACE_EMAIL_FROM=MirrorTrace <your-sender@example.com>

WATCH_PROCESSOR_SECRET=replace-with-secret
MIRRORTRACE_SCHEDULER_SECRET=replace-with-secret
