# ============================================================
# MirrorTrace Environment Template
# ============================================================

# ============================================================
# GEMINI - SERVER ONLY
# ============================================================

GEMINI_API_KEY=

# ============================================================
# FIREBASE ADMIN
# ============================================================

FIREBASE_PROJECT_ID=mirrortrace-9b161

# ============================================================
# FIREBASE WEB SDK
# Public client configuration - NOT Firebase Admin credentials.
# ============================================================

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=mirrortrace-9b161.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=mirrortrace-9b161
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

VITE_FIREBASE_DATABASE_ID=(default)

# ============================================================
# FIREBASE CLOUD MESSAGING
# Public Web Push certificate key generated in:
# Firebase Console -> Project Settings -> Cloud Messaging
# ============================================================

VITE_FIREBASE_VAPID_KEY=

# ============================================================
# MIRRORTRACE PUBLIC APPLICATION URL
# ============================================================

# Local:
MIRRORTRACE_APP_URL=http://localhost:3000

# Compatibility alias used by some older MirrorTrace code.
APP_BASE_URL=http://localhost:3000

# ============================================================
# PERSPECTIVE WATCH SCHEDULER
# SERVER ONLY - NEVER PREFIX THESE WITH VITE_
# ============================================================

# Existing email processor currently reads this name.
MIRRORTRACE_SCHEDULER_SECRET=

# Compatibility with the Secret Manager secret already created
# earlier for MirrorTrace.
WATCH_PROCESSOR_SECRET=

# Firebase Trigger Email extension collection.
MIRRORTRACE_MAIL_COLLECTION=mail