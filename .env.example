# ============================================================
# MirrorTrace Environment Template
# ============================================================

# SERVER ONLY
# Put the real value in AI Studio Secrets / Cloud Run Secret Manager.
GEMINI_API_KEY=""

# Firebase server project
FIREBASE_PROJECT_ID="mirrortrace-9b161"

# Firebase Web SDK configuration
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN="mirrortrace-9b161.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="mirrortrace-9b161"
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# Default Firestore database
VITE_FIREBASE_DATABASE_ID="(default)"

# Production URL
APP_URL=""
# ============================================================
# MirrorTrace
# ============================================================

# Gemini
GEMINI_API_KEY=

# Firebase Admin / project configuration
FIREBASE_PROJECT_ID=

# Existing frontend Firebase settings remain here if already used.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ============================================================
# Perspective Watch
# ============================================================

# Public deployed MirrorTrace URL.
# Used only for the secure "Open MirrorTrace" link in reminder email.
APP_BASE_URL=http://localhost:3000

# Random server-only secret used by Cloud Scheduler.
# NEVER expose this as VITE_*.
WATCH_PROCESSOR_SECRET=